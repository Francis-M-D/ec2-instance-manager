EC2MANAGER_DB_CONNECTION=Server=mysql;Port=3306;Database=ec2manager;User=root;Password=root;
EC2MANAGER_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
EC2MANAGER_CLOUD_SERVICE_URL=http://cloud-service:8001
EC2MANAGER_INTERNAL_API_KEY=change-me-shared-secret
EC2MANAGER_FRONTEND_ORIGIN=http://localhost:5173

# Must match cloud-service's values exactly (both services decrypt the same blob)
EC2MANAGER_DECRYPTION_KEY=
EC2MANAGER_AWS_ACCOUNTS_ENCRYPTED=

# --- Initial admin bootstrap (one-time only) ---
# There is no public registration page. On first startup, if the Users
# table is empty, these three variables create the one and only initial
# administrator. After that account is created (check the backend logs for
# confirmation), remove EC2MANAGER_INITIAL_ADMIN_PASSWORD from this file —
# it is never used again while any user exists in the database.
# Password policy: 12+ chars, at least one uppercase, one lowercase, one digit.
EC2MANAGER_INITIAL_ADMIN_USERNAME=admin
EC2MANAGER_INITIAL_ADMIN_PASSWORD=
EC2MANAGER_INITIAL_ADMIN_EMAIL=admin@example.com
