# Generate these with: python generate_encrypted_config.py
EC2MANAGER_DECRYPTION_KEY=
EC2MANAGER_AWS_ACCOUNTS_ENCRYPTED=

# Shared secret the .NET backend must send as: Authorization: Bearer <this>
EC2MANAGER_INTERNAL_API_KEY=change-me-shared-secret

# Optional: seconds for each assumed-role session (default 3600)
EC2MANAGER_ASSUME_ROLE_DURATION=3600
